# Copy to .env.prod on the device and fill in. .env.prod is never committed or baked into an image.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
CLIENT_URL=https://ludo.aetherinc.xyz
# Login is by username (a phone number also works). The admin is only created when no admin exists yet.
# To change the password later use the admin-password tool (docs/ARCHITECTURE.md, "Admin credentials").
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional (defaults shown). Day and month boundaries of the dashboard and statements follow APP_TIMEZONE.
# TRUST_PROXY=1
# APP_TIMEZONE=Asia/Kolkata
# DB_POOL_MAX=8
